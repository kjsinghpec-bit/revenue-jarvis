# Copy to .env and edit. Every setting is optional.
# Your own copy of the Bhumbak book PDF - lets Jarvis show the original scanned page next to each citation.
# JARVIS_BOOK_PDF=/Users/karamjot/Documents/Punjabi book .pdf

# Thinking engine: auto | claude | codex | none   (auto = Claude Code, then Codex, then sources-only)
JARVIS_LLM_BACKEND=auto
# JARVIS_CLAUDE_MODEL=sonnet

# Speech-to-text: mlx (local, Apple Silicon) | faster-whisper (local, CPU) | browser (Chrome/Safari recogniser)
JARVIS_STT_ENGINE=mlx
# JARVIS_WHISPER_MODEL=mlx-community/whisper-large-v3-turbo   # use mlx-community/whisper-small-mlx if memory is tight

JARVIS_USER_TITLE=sir
JARVIS_PORT=8765
